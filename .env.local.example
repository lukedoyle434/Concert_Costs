# Copy this file to .env.local and fill in your Supabase project values.
#
# How to find these values:
# 1. Open https://supabase.com and sign in
# 2. Open your "Concert Costs" project
# 3. Go to Connect (or Settings > API Keys)
# 4. Copy the Project URL into NEXT_PUBLIC_SUPABASE_URL
# 5. Copy the publishable key (or the anon public key) into NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# IMPORTANT: Never put your service role key or secret key here.
# This file is loaded by the browser, so only use public/publishable keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here
